---
// src/components/Navbar.astro
import ModalContacto from './ModalContacto.astro';
import AuthModals from './AuthModals.astro';
---

<header class="border-b border-neutral-800 bg-neutral-950/80 backdrop-blur-md sticky top-0 z-50">
  <nav class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 group">
      <span class="bg-emerald-600 text-white text-xs font-black px-2 py-1 rounded-md tracking-wider group-hover:bg-emerald-500 transition">
        JDEV
      </span>
      <span class="font-extrabold text-lg text-white tracking-tight">
        Mi<span class="text-emerald-400">Canasta</span>
      </span>
    </a>

    <!-- Enlaces de navegación -->
    <div class="flex items-center gap-6 text-sm font-medium text-neutral-300">
      <a href="/" class="hover:text-emerald-400 transition">Inicio</a>
      
      <!-- Botón de Contacto -->
      <ModalContacto />
      <a id="favoritos-link" href="/favoritos" class="hidden hover:text-emerald-400 transition">Lista de favoritos</a>
      <AuthModals />

      <div id="google-auth-container" class="border-l border-neutral-800 pl-6">
        <button id="google-auth-btn" class="bg-neutral-900 hover:bg-neutral-800 border border-neutral-700 text-neutral-200 text-xs font-semibold px-3.5 py-2 rounded-lg transition flex items-center gap-2 cursor-pointer min-w-[170px] justify-center">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" />
            <path d="m22 6-10 7L2 6" />
          </svg>
          <span class="flex flex-col items-start leading-tight text-left">
            <span id="google-auth-label">Ingresa</span>
            <span id="google-auth-subtitle" class="text-[10px] text-neutral-500 font-medium">Guardar favoritos</span>
          </span>
        </button>
      </div>
    </div>

  </nav>
</header>

<div
  id="favoritos-toast"
  class="fixed top-20 left-1/2 -translate-x-1/2 z-[1100] bg-neutral-900 border border-emerald-500/50 text-white px-4 py-2.5 rounded-xl shadow-2xl flex items-center gap-2.5 transition-all duration-300 opacity-0 -translate-y-3 pointer-events-none"
>
  <span id="favoritos-toast-icon" class="w-5 h-5 rounded-full bg-emerald-600/20 text-emerald-400 flex items-center justify-center text-xs font-bold">✓</span>
  <span id="favoritos-toast-mensaje" class="text-xs font-medium">Se agregó a favoritos.</span>
</div>

<script>
  import { supabase } from '../lib/supabase.js';
  import { cerrarSesion, obtenerSesionActual } from '../lib/interacciones.js';

  const authBtn = document.getElementById('google-auth-btn') as HTMLButtonElement | null;
  const authLabel = document.getElementById('google-auth-label');
  const authSubtitle = document.getElementById('google-auth-subtitle');
  const favoritosLink = document.getElementById('favoritos-link');
  const favoritosToast = document.getElementById('favoritos-toast');
  const favoritosToastMensaje = document.getElementById('favoritos-toast-mensaje');
  const favoritosToastIcon = document.getElementById('favoritos-toast-icon');
  let favoritosToastTimeoutId = 0;

  async function pintarEstadoAuth() {
    const session = await obtenerSesionActual();

    if (!authBtn || !authLabel || !authSubtitle || !favoritosLink) return;

    if (session?.user) {
      const nombre = session.user.user_metadata?.full_name || session.user.user_metadata?.name || session.user.email || 'Mi cuenta';
      authLabel.textContent = nombre;
      authSubtitle.textContent = 'Salir de la cuenta';
      authBtn.title = 'Cerrar sesión';
      authBtn.classList.add('border-emerald-500/50', 'bg-emerald-950/40', 'text-emerald-100');
      authBtn.classList.remove('border-neutral-700', 'bg-neutral-900', 'text-neutral-200');
      favoritosLink.classList.remove('hidden');
    } else {
      authLabel.textContent = 'Ingresa';
      authSubtitle.textContent = 'Guardar favoritos';
      authBtn.title = 'Ingresa';
      authBtn.classList.add('border-neutral-700', 'bg-neutral-900', 'text-neutral-200');
      authBtn.classList.remove('border-emerald-500/50', 'bg-emerald-950/40', 'text-emerald-100');
      favoritosLink.classList.add('hidden');
    }
  }

  function mostrarToastFavoritos(mensaje: string, tipo: 'success' | 'error' = 'success') {
    if (!favoritosToast || !favoritosToastMensaje || !favoritosToastIcon) return;

    if (favoritosToastTimeoutId) {
      window.clearTimeout(favoritosToastTimeoutId);
    }

    const esError = tipo === 'error';
    favoritosToastMensaje.textContent = mensaje;
    favoritosToastIcon.textContent = esError ? '!' : '✓';
    favoritosToastIcon.className = esError
      ? 'w-5 h-5 rounded-full bg-red-500/20 text-red-300 flex items-center justify-center text-xs font-bold'
      : 'w-5 h-5 rounded-full bg-emerald-600/20 text-emerald-400 flex items-center justify-center text-xs font-bold';
    favoritosToast.className = esError
      ? 'fixed top-20 left-1/2 -translate-x-1/2 z-[1100] bg-neutral-900 border border-red-500/50 text-white px-4 py-2.5 rounded-xl shadow-2xl flex items-center gap-2.5 transition-all duration-300 opacity-0 -translate-y-3 pointer-events-none'
      : 'fixed top-20 left-1/2 -translate-x-1/2 z-[1100] bg-neutral-900 border border-emerald-500/50 text-white px-4 py-2.5 rounded-xl shadow-2xl flex items-center gap-2.5 transition-all duration-300 opacity-0 -translate-y-3 pointer-events-none';

    requestAnimationFrame(() => {
      favoritosToast.classList.remove('opacity-0', '-translate-y-3', 'pointer-events-none');
      favoritosToast.classList.add('opacity-100', 'translate-y-0');
    });

    favoritosToastTimeoutId = window.setTimeout(() => {
      favoritosToast.classList.remove('opacity-100', 'translate-y-0');
      favoritosToast.classList.add('opacity-0', '-translate-y-3', 'pointer-events-none');
    }, 2400);
  }

  authBtn?.addEventListener('click', async () => {
    const session = await obtenerSesionActual();

    if (session?.user) {
      await cerrarSesion();
      window.dispatchEvent(new CustomEvent('micanasta-auth-change', { detail: null }));
      await pintarEstadoAuth();
      return;
    }

    window.dispatchEvent(new Event('micanasta-open-auth-login'));
  });

  const manejarCambioFavorito = ((event: Event) => {
    const detail = (event as CustomEvent<{ mensaje?: string; activo?: boolean }>).detail;
    if (!detail?.mensaje) return;

    mostrarToastFavoritos(detail.mensaje, detail.activo ? 'success' : 'error');
  }) as EventListener;

  window.addEventListener('micanasta-favorito-change', manejarCambioFavorito);

  supabase.auth.onAuthStateChange((_event, session) => {
    window.dispatchEvent(new CustomEvent('micanasta-auth-change', { detail: session }));
    pintarEstadoAuth();
  });

  pintarEstadoAuth();
</script>