---
// src/components/Navbar.astro
---
<header class="border-b border-neutral-800 bg-neutral-950/80 backdrop-blur-md sticky top-0 z-50">
  <nav class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 group">
      <span class="bg-emerald-600 text-white text-xs font-black px-2 py-1 rounded-md tracking-wider group-hover:bg-emerald-500 transition">
        JDEV
      </span>
      <span class="font-extrabold text-lg text-white tracking-tight">
        Mi<span class="text-emerald-400">Canasta</span>
      </span>
    </a>

    <!-- Enlaces de navegación -->
    <div class="flex items-center gap-6 text-sm font-medium text-neutral-300">
      <a href="/" class="hover:text-emerald-400 transition">Inicio</a>
      <a href="/agregar" class="hover:text-emerald-400 transition">Formulario</a>
      
      <!-- Espacio reservado para el inicio de sesión de Google (próximamente) -->
      <div id="google-auth-container" class="border-l border-neutral-800 pl-6">
        <button class="bg-neutral-900 hover:bg-neutral-800 border border-neutral-700 text-neutral-200 text-xs font-semibold px-3.5 py-2 rounded-lg transition flex items-center gap-2">
          <svg class="w-4 h-4" viewBox="0 0 24 24">
            <path fill="currentColor" d="M12 5c1.6 0 3 .6 4.1 1.6l3.1-3.1C17.3 1.8 14.8 1 12 1 7.4 1 3.5 3.6 1.6 7.4l3.7 2.9C6.2 7.1 8.9 5 12 5z"/>
            <path fill="currentColor" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5c-.3 1.5-1.1 2.8-2.4 3.7l3.7 2.9c2.2-2 3.7-5 3.7-8.8z"/>
            <path fill="currentColor" d="M5.3 14.7c-.2-.8-.4-1.7-.4-2.7s.2-1.9.4-2.7L1.6 6.4C.6 8.4 0 10.6 0 13s.6 4.6 1.6 6.6l3.7-2.9z"/>
            <path fill="currentColor" d="M12 23c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3.1 0-5.8-2.1-6.7-5.3L1.6 15.6C3.5 19.4 7.4 23 12 23z"/>
          </svg>
          Ingresar
        </button>
      </div>
    </div>

  </nav>
</header>