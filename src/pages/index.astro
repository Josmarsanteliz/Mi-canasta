---
import { supabase } from '../lib/supabase.js';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CarritoFlotante from '../components/CarritoFlotante.astro';
import { desglosarPrecioDoble, alternarFavoritoProducto, obtenerIdsFavoritosActuales } from '../lib/interacciones.js';

import '../styles/global.css';

const { data: productos } = await supabase.from('productos').select('*');
const { data: precios } = await supabase.from('precios_tiendas').select('*');

let tasaDolar = 1;
try {
  const resTasa = await fetch('https://ve.dolarapi.com/v1/dolares/oficial');
  if (resTasa.ok) {
    const dataTasa = await resTasa.json();
    tasaDolar = dataTasa?.promedio || 1;
  }
} catch (e) {
  console.error('Error al obtener la tasa:', e);
}

function parsePrecio(texto: string): number {
  if (!texto) return 0;
  const limpio = texto.replace(/[^0-9.,]/g, '').replace(',', '.');
  const num = parseFloat(limpio);
  return isNaN(num) ? 0 : num;
}

function esTuZona(tienda?: string) {
  return (tienda || '').toLowerCase().includes('tuzona');
}
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MiCanasta - Comparador de Precios</title>
  </head>
  <body class="bg-neutral-950 text-white min-h-screen font-sans flex flex-col justify-between selection:bg-emerald-500 selection:text-white">
    
    <Navbar />

    <main class="max-w-6xl mx-auto px-6 py-12 space-y-8 flex-grow w-full">
      <div>
        <h1 class="text-4xl font-extrabold tracking-tight">Compara precios en tiempo real</h1>
        <p class="text-neutral-400 mt-2">Encuentra las mejores ofertas entre los supermercados más importantes.</p>
        <p class="text-xs text-neutral-500 mt-1">
          Tasa oficial BCV: <span class="text-emerald-400 font-semibold">Bs. {tasaDolar.toFixed(2)}</span>
        </p>
      </div>

      <div class="relative">
        <input 
          type="text" 
          placeholder="Buscar productos..." 
          class="w-full bg-neutral-900 border border-neutral-800 rounded-xl px-4 py-3.5 text-sm text-white placeholder-neutral-500 focus:outline-none focus:border-emerald-500 transition shadow-inner"
        />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {productos && productos.map((prod) => {
          const preciosProd = precios?.filter(p => p.producto_id === prod.id) || [];
          const primerPrecioTexto = preciosProd.length > 0 ? preciosProd[0].precio_texto : 'Pendiente';
          const precioTuZona = desglosarPrecioDoble(primerPrecioTexto);
          const mostrarPrecioDoble = esTuZona(preciosProd[0]?.tienda) && precioTuZona.tieneDoblePrecio;
          const valorNum = parsePrecio(primerPrecioTexto);
          const precioEnBs = valorNum > 0 ? valorNum * tasaDolar : 0;
          const precioTuZonaPrincipalBs = mostrarPrecioDoble ? parsePrecio(String(precioTuZona.principal || '')) * tasaDolar : 0;
          const precioTuZonaSecundarioBs = mostrarPrecioDoble ? parsePrecio(String(precioTuZona.secundario || '')) * tasaDolar : 0;

          return (
            <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-5 flex flex-col justify-between hover:border-neutral-700 transition shadow-lg">
              <div>
                {prod.imagen_url ? (
                  <div class="w-full h-48 bg-white rounded-lg mb-4 flex items-center justify-center p-2 border border-neutral-800 overflow-hidden">
                    <img src={prod.imagen_url} alt={prod.nombre} class="w-full h-full object-contain" />
                  </div>
                ) : (
                  <div class="w-full h-48 bg-neutral-800 rounded-lg mb-4 flex items-center justify-center text-xs text-neutral-500">
                    Sin imagen
                  </div>
                )}
                <span class="text-xs uppercase tracking-wider bg-neutral-800 text-neutral-300 px-2.5 py-1 rounded-full font-semibold">
                  {prod.categoria}
                </span>
                <h2 class="text-lg font-bold text-white mt-3">{prod.nombre}</h2>
              </div>
              
              <div class="mt-6 pt-4 border-t border-neutral-800 flex items-center justify-between">
                <div class="min-w-0">
                  <span class="text-xs text-neutral-400 block">Referencia Tienda</span>
                  {mostrarPrecioDoble ? (
                    <div class="flex flex-col gap-1 leading-tight">
                      <div>
                        <span class="block text-[11px] text-neutral-500 font-medium">Primer precio</span>
                        <span class="block text-sm font-semibold text-neutral-300">{precioTuZona.secundario}</span>
                        {precioTuZonaSecundarioBs > 0 && (
                          <span class="block text-[11px] text-neutral-500 font-medium">
                            ≈ Bs. {precioTuZonaSecundarioBs.toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                          </span>
                        )}
                      </div>
                      <div class="pt-1 border-t border-neutral-800">
                        <span class="block text-xs text-neutral-400 font-medium">Precio normal</span>
                        <span class="block text-xl font-black text-emerald-400">{precioTuZona.principal}</span>
                        {precioTuZonaPrincipalBs > 0 && (
                          <span class="block text-[11px] text-neutral-400 font-medium">
                            ≈ Bs. {precioTuZonaPrincipalBs.toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                          </span>
                        )}
                      </div>
                    </div>
                  ) : (
                    <span class="text-lg font-extrabold text-emerald-400 break-words">{primerPrecioTexto}</span>
                  )}
                  {!mostrarPrecioDoble && precioEnBs > 0 && (
                    <span class="text-[11px] text-neutral-400 block font-medium">
                      ≈ Bs. {precioEnBs.toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                    </span>
                  )}
                </div>
                <div class="flex items-center gap-2 shrink-0">
                <button 
  data-auth-only-favorito
  type="button"
  data-favorito-btn
  data-id={prod.id}
  data-nombre={prod.nombre}
  data-imagen={prod.imagen_url || ''}
  class="favorito-btn hidden bg-neutral-900 hover:bg-neutral-800 border border-neutral-700 text-neutral-300 p-2 rounded-xl transition cursor-pointer flex items-center justify-center shadow-md"
  title="Guardar en favoritos"
  aria-pressed="false"
>
  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 10-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
  </svg>
</button>
                <button 
  data-id={prod.id} 
  data-nombre={prod.nombre} 
  data-imagen={prod.imagen_url} 
  class="agregar-carrito-btn bg-emerald-600 hover:bg-emerald-500 text-white p-2 rounded-xl transition cursor-pointer flex items-center justify-center shadow-md"
  title="Agregar a la lista"
>
  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
  </svg>
</button>
                  <a href={`/producto/${prod.id}`} class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold px-4 py-2.5 rounded-lg transition">
                    Ver tiendas
                  </a>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </main>

    <Footer />
    <CarritoFlotante />

    <script>
      import { alternarFavoritoProducto, obtenerIdsFavoritosActuales, obtenerSesionActual } from '../lib/interacciones.js';

      const searchInput = document.querySelector('input[placeholder="Buscar productos..."]');
      const productCards = document.querySelectorAll('.grid > div');
      const favoriteButtons = document.querySelectorAll('[data-favorito-btn]');
      const favoriteVisibilityButtons = document.querySelectorAll('[data-auth-only-favorito]');

      function pintarFavorito(btn: HTMLButtonElement, activo: boolean) {
        btn.setAttribute('aria-pressed', String(activo));
        btn.title = activo ? 'Quitar de favoritos' : 'Guardar en favoritos';
        btn.classList.toggle('bg-rose-500', activo);
        btn.classList.toggle('border-rose-500', activo);
        btn.classList.toggle('text-white', activo);
        btn.classList.toggle('bg-neutral-900', !activo);
        btn.classList.toggle('border-neutral-700', !activo);
        btn.classList.toggle('text-neutral-300', !activo);
      }

      async function actualizarEstadoFavoritos() {
        const idsFavoritos = await obtenerIdsFavoritosActuales();
        favoriteButtons.forEach((button) => {
          const htmlButton = button as HTMLButtonElement;
          const esFavorito = idsFavoritos.has(String(htmlButton.dataset.id));
          pintarFavorito(htmlButton, esFavorito);
        });
      }

      async function actualizarVisibilidadFavoritos() {
        const session = await obtenerSesionActual();

        favoriteVisibilityButtons.forEach((button) => {
          const htmlButton = button as HTMLButtonElement;
          htmlButton.classList.toggle('hidden', !session?.user);
        });
      }

      favoriteButtons.forEach((button) => {
        button.addEventListener('click', async () => {
          const htmlButton = button as HTMLButtonElement;
          const result = await alternarFavoritoProducto({
            id: htmlButton.dataset.id,
            nombre: htmlButton.dataset.nombre,
            imagen: htmlButton.dataset.imagen,
          });

          if (result.requiereInicioSesion) return;
          pintarFavorito(htmlButton, result.activo);
        });
      });

      window.addEventListener('micanasta-auth-change', () => {
        actualizarEstadoFavoritos();
        actualizarVisibilidadFavoritos();
      });

      searchInput?.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        const term = target ? target.value.toLowerCase() : '';
        productCards.forEach((card) => {
          const htmlCard = card as HTMLElement;
          const title = htmlCard.querySelector('h2')?.textContent?.toLowerCase() || '';
          if (title.includes(term)) {
            htmlCard.style.display = 'flex';
          } else {
            htmlCard.style.display = 'none';
          }
        });
      });

      actualizarEstadoFavoritos();
      actualizarVisibilidadFavoritos();
    </script>
  </body>
</html>